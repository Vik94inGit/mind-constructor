# Copy to .env for local dev. In Render, set these as dashboard env vars instead
# (see render.yaml) — never commit a real .env.

PORT=3000
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<db>?retryWrites=true&w=majority

# Signs the session cookie (express-session) — a fresh secret, unrelated to
# the old JWT_SECRET this replaced.
SESSION_SECRET=replace-with-a-long-random-string

# Session store. Required in production (server.ts hard-fails startup
# without it there). Left unset locally, sessions fall back to
# express-session's in-memory MemoryStore, which is fine for local dev/test
# but loses every session on restart and never in production. On Render,
# deploying render.yaml as a Blueprint provisions a free Key Value instance
# and wires this automatically (fromService) — no manual copy-paste needed
# there. For local dev, point this at a real Redis (Upstash's free tier is
# the easiest — sign up, create a database, copy its "redis://..." or
# "rediss://..." URL here) or just leave it unset.
REDIS_URL=

# "none" (the default when unset) or "lax" — see server.ts's own cookie
# config comment. Only relevant in production; local dev always uses "lax".
COOKIE_SAMESITE=

# OAuth client id from Google Cloud Console (APIs & Services > Credentials >
# Create Credentials > OAuth client ID > Web application). Must match the
# frontend's VITE_GOOGLE_CLIENT_ID exactly — the backend verifies every
# Google ID token's `aud` claim against this value. Add both your dev
# origin (http://localhost:5173) and your deployed frontend origin to that
# same OAuth client's "Authorized JavaScript origins".
GOOGLE_CLIENT_ID=

# Comma-separated list of allowed frontend origins, e.g.:
# CORS_ORIGIN=https://my-app.vercel.app
# Required in production (server.ts hard-fails startup without it) — a
# credentialed session cookie needs an explicit origin, not a wildcard.
# Leave unset locally — defaults to allowing all origins.
CORS_ORIGIN=

# File storage for node pictures (src/config/fileStorage.ts) — any
# S3-compatible bucket; Cloudflare R2 is the suggested one (10 GB free, no
# download fees). Cloudflare dashboard > R2 > Create bucket (keep it private),
# then R2 > Manage API tokens > Create token with "Object Read & Write" on that
# bucket: it shows the access key id, the secret and the S3 endpoint
# (https://<account id>.r2.cloudflarestorage.com). Leave S3_BUCKET unset to
# keep pictures in MongoDB instead (fine locally). After setting these on the
# deployed backend, run `npm run images:move` once to move existing pictures.
S3_BUCKET=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# "auto" for R2 (the default when unset); your bucket's region for Amazon S3.
S3_REGION=
