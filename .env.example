# Copy to .env (next to docker-compose.yml) and fill in. See DEPLOY.md.

# The site's public address, exactly as people open it.
PUBLIC_URL=https://mind.capantcloud.eu

# A long random string that signs sign-in cookies. Make one with:
#   openssl rand -hex 32
SESSION_SECRET=

# Optional: "Sign in with Google" — the OAuth client id from Google Cloud
# Console (add PUBLIC_URL to its "Authorized JavaScript origins").
GOOGLE_CLIENT_ID=

# Optional: use an existing database (e.g. the MongoDB Atlas one the
# Render deploy uses) instead of the one docker compose starts here.
# MONGO_URI=

# Optional: a different port on the server than 3000.
# WEB_PORT=3000
