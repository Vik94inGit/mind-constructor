{
  "name": "Mind Constructor",
  "short_name": "Mind Constructor",
  "description": "Notes you can see: jot thoughts down, then lay them out on a map to think them through — on your own or together.",
  "id": "/",
  "start_url": "/?resume=1",
  "scope": "/",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#12141b",
  "theme_color": "#b5651d",
  "icons": [
    { "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "/icons/icon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" }
  ],
  "shortcuts": [
    { "name": "Quick note", "url": "/?note=1", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Text → map", "url": "/split", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Think it through", "url": "/think", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] }
  ]
}
