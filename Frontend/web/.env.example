# Local dev only — points straight at the local backend. Leave unset in
# production: REST calls go out as same-origin relative paths instead,
# routed through vercel.json's /api/(.*) rewrite to the Render backend, so
# the session cookie reads as first-party for that traffic (see
# api/client.ts).
VITE_API_URL=http://localhost:3000

# A production build ignores VITE_API_URL and always calls the same-origin
# /api path (the vercel.json rewrite): a cross-site API makes the session
# cookie third-party, which Safari blocks, so signing in on an iPhone or a
# Mac would fail with "Not authorized". Set this to "true" only for a
# deploy with no such rewrite in front of the backend.
# VITE_API_DIRECT=true

# Socket.IO's own absolute backend URL — always required (production
# included), since the socket connection is *not* routed through the
# vercel.json rewrite (a Vercel rewrite to an external host doesn't
# reliably carry a WebSocket upgrade) and stays cross-site either way.
# Defaults to VITE_API_URL if unset, which is enough for local dev where
# both point at the same local backend.
VITE_SOCKET_URL=http://localhost:3000

# Same OAuth client id as the backend's GOOGLE_CLIENT_ID (Google Cloud
# Console > APIs & Services > Credentials) — this one is public (it's sent
# to the browser), the backend's is what actually gets verified against.
VITE_GOOGLE_CLIENT_ID=
